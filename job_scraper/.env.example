# Job scraper configuration. Copy to .env — never commit the real .env.

# --- Required ---
# Same Postgres the backend reads. The scraper writes raw_jobs + scraped_jobs.
DATABASE_URL=postgresql://user:pass@host:5432/postgres

# --- Optional API keys (sources fall back to scraping / are skipped if empty) ---
JSEARCH_KEY=              # RapidAPI key for JSearch
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
SERPAPI_KEY=
ZIPRECRUITER_API_KEY=

# --- Session cookies for browser-based boards (optional) ---
LINKEDIN_LI_AT=
WELLFOUND_SESSION=
GLASSDOOR_SESSION=

# --- Optional Elasticsearch index (pipeline works without it) ---
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=jobs

# --- Anti-detect ---
PROXY_LIST=               # comma-separated proxy URLs
PLAYWRIGHT_HEADLESS=true

# --- Behaviour ---
MAX_AGE_HOURS=24
REQUEST_TIMEOUT_SECONDS=30
CONCURRENT_ADAPTERS=4
SCRAPE_INTERVAL_HOURS=1
